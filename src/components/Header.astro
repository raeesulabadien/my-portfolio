---
const navLinks = [
  { label: 'Home',     href: '/' },
  { label: 'About',    href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'Blog',     href: '/blog' },
  { label: 'Contact',  href: '/contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" role="banner">
  <div class="container header-inner">

    <!-- Site identity -->
    <a href="/" class="site-identity" aria-label="Muhammad Raees Ul Abadien — home">
      <span class="identity-name">Raees Ul Abadien</span>
    </a>

    <!-- Primary navigation -->
    <nav aria-label="Primary navigation">
      <ul class="nav-list" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { 'nav-link--active': isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Theme toggle -->
    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="Toggle light and dark theme"
      title="Toggle theme"
    >
      <!-- Moon icon (shown in light mode — click to go dark) -->
      <svg class="icon-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <!-- Sun icon (shown in dark mode — click to go light) -->
      <svg class="icon-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" />
        <line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" />
        <line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
    </button>

    <!-- Mobile menu toggle -->
    <button
      id="mobile-menu-toggle"
      class="mobile-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg class="icon-menu" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg class="icon-close" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

  </div>

  <!-- Mobile navigation drawer -->
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
    <ul class="mobile-nav-list" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['mobile-nav-link', { 'mobile-nav-link--active': isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // ── Theme Toggle ──────────────────────────────────────────
  const themeToggle = document.getElementById('theme-toggle');

  function getTheme(): string {
    return document.documentElement.getAttribute('data-theme') ?? 'light';
  }

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    try { localStorage.setItem('theme', theme); } catch {}
    if (themeToggle) {
      themeToggle.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
      );
    }
  }

  themeToggle?.addEventListener('click', () => {
    applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
  });

  // ── Mobile Menu Toggle ────────────────────────────────────
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileNav    = document.getElementById('mobile-nav');

  mobileToggle?.addEventListener('click', () => {
    const isOpen = mobileToggle.getAttribute('aria-expanded') === 'true';
    mobileToggle.setAttribute('aria-expanded', String(!isOpen));
    mobileToggle.setAttribute(
      'aria-label',
      isOpen ? 'Open navigation menu' : 'Close navigation menu'
    );
    if (mobileNav) {
      mobileNav.hidden = isOpen;
    }
  });

  // Close mobile menu when a nav link is activated
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (mobileNav) mobileNav.hidden = true;
      if (mobileToggle) {
        mobileToggle.setAttribute('aria-expanded', 'false');
        mobileToggle.setAttribute('aria-label', 'Open navigation menu');
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color var(--transition-slow),
      border-color var(--transition-slow);
  }

  .header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: var(--space-6);
  }

  /* Identity */
  .site-identity {
    text-decoration: none;
    flex-shrink: 0;
    margin-right: auto;
  }

  .identity-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    transition: color var(--transition-base);
  }

  .site-identity:hover .identity-name {
    color: var(--color-accent);
  }

  /* Desktop nav */
  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--transition-base), background-color var(--transition-base);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-alt);
  }

  .nav-link--active {
    color: var(--color-text-primary);
    background-color: var(--color-surface-alt);
  }

  /* Theme toggle */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      color var(--transition-base),
      border-color var(--transition-base),
      background-color var(--transition-base);
  }

  .theme-toggle:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-alt);
    border-color: var(--color-border-focus);
  }

  /* Icon visibility controlled by data-theme */
  .icon-moon { display: block; }
  .icon-sun  { display: none; }

  [data-theme="dark"] .icon-moon { display: none; }
  [data-theme="dark"] .icon-sun  { display: block; }

  /* Mobile toggle — hidden on desktop */
  .mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      color var(--transition-base),
      border-color var(--transition-base),
      background-color var(--transition-base);
  }

  .mobile-toggle:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-alt);
    border-color: var(--color-border-focus);
  }

  /* Toggle icon states */
  .icon-close { display: none; }

  .mobile-toggle[aria-expanded="true"] .icon-menu  { display: none; }
  .mobile-toggle[aria-expanded="true"] .icon-close { display: block; }

  /* Mobile nav drawer */
  .mobile-nav {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) var(--container-pad);
    transition: background-color var(--transition-slow);
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-nav-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: color var(--transition-base), background-color var(--transition-base);
  }

  .mobile-nav-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-alt);
  }

  .mobile-nav-link--active {
    color: var(--color-text-primary);
    background-color: var(--color-surface-alt);
  }

  /* Responsive breakpoint */
  @media (max-width: 767px) {
    .nav-list {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .site-header {
      height: var(--header-height);
    }
  }
</style>
